# ==============================================================================
# OpenReview Configuration Environment Template
# Copy this file to .env and populate with your credentials.
# NEVER commit real private keys, secrets, or API keys to source control.
# ==============================================================================

# Server Network Settings
HOST=0.0.0.0
PORT=3000
# Must be the GitHub mention/handle of the App you actually registered.
# If the App is named "OpenReview MyTeam", do not leave this as "openreview".
BOT_USERNAME=openreview

# GitHub App Configuration (Required for Webhook Daemon)
# Obtain these from your GitHub App settings: https://github.com/settings/apps
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_WEBHOOK_SECRET=your_hmac_webhook_secret_here

# GitHub App Installation ID (Optional)
# In production multi-tenant deployments, installation IDs are automatically resolved
# from incoming authenticated webhooks. This setting is strictly for CLI / standalone testing.
GITHUB_APP_INSTALLATION_ID=

# Explicit operator approval for webhook installations (numeric IDs, comma-separated).
# Public Apps can be installed by anyone; signing alone must not authorize jobs.
# Empty = accept no PR review/fix jobs until you approve an installation.
ALLOWED_INSTALLATION_IDS=

# Primary LLM Provider: "anthropic" | "openai" | "gemini" | "ollama"
LLM_PROVIDER=anthropic
LLM_MODEL=claude-3-7-sonnet-20250219

# Provider Credentials (populate the one matching LLM_PROVIDER)
ANTHROPIC_API_KEY=sk-ant-api03-...
OPENAI_API_KEY=sk-proj-...
OPENAI_BASE_URL=https://api.openai.com
GEMINI_API_KEY=AIzaSy...
OLLAMA_BASE_URL=http://localhost:11434

# Sandbox Execution Driver: "local" | "docker"
# "local" runs in ephemeral sandboxed directories with stripped host secrets.
# "docker" runs inside isolated OCI containers with CPU, memory, and capability caps.
SANDBOX_DRIVER=docker
SANDBOX_DOCKER_SOCKET=
SANDBOX_WORKSPACE_DIR=/srv/openreview/workspaces

# Required to access the protected job-status API; generate a long random value.
JOB_API_TOKEN=
MAX_CONCURRENT_JOBS=10
