{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openreview:spec:v1:playbook",
  "title": "OpenReview proposed constrained Playbook v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "scope", "steps"],
  "properties": {
    "version": { "const": "1" },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$" },
    "description": { "type": "string", "maxLength": 2000 },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modes"],
      "properties": {
        "modes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["review", "suggest", "fix"] } },
        "allowed_paths": { "type": "array", "items": { "type": "string", "maxLength": 4096 } },
        "max_steps": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "preconditions": { "type": "array", "items": { "type": "string", "maxLength": 512 } },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "operation", "description"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
          "operation": { "enum": ["read", "inspect", "check", "review", "propose_patch", "authorized_fix"] },
          "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "requires": { "type": "array", "items": { "type": "string", "maxLength": 64 } },
          "evidence_required": { "type": "boolean", "default": true }
        }
      }
    }
  }
}
