{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openreview:spec:v1:finding",
  "title": "OpenReview proposed VerifiedFinding v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "finding_id", "head_sha", "path", "title", "severity", "validation_state", "explanation", "source_spans"],
  "properties": {
    "schema_version": { "const": "1" },
    "finding_id": { "type": "string", "minLength": 1 },
    "head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "title": { "type": "string", "minLength": 1, "maxLength": 256 },
    "severity": { "enum": ["informational", "low", "medium", "high", "critical", "unknown"] },
    "validation_state": { "enum": ["candidate", "code_inspected", "reproduced", "disproved", "uncertain"] },
    "explanation": { "type": "string", "minLength": 1, "maxLength": 10000 },
    "source_spans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "start_line", "end_line"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "start_line": { "type": "integer", "minimum": 1 },
          "end_line": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "evidence_refs": { "type": "array", "items": { "type": "string", "maxLength": 1024 } },
    "related_thread_ids": { "type": "array", "items": { "type": "string" } },
    "risk_score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "coverage_note": { "type": ["string", "null"] },
    "suggested_patch": { "type": ["string", "null"] }
  }
}
